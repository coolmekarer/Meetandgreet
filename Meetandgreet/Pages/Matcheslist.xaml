<Page x:Class="Meetandgreet.Pages.Matcheslist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Matcheslist">

    <Page.Resources>
        <DropShadowEffect x:Key="ShadowEffect" 
                          BlurRadius="10" 
                          ShadowDepth="2" 
                          Opacity="0.3" 
                          Color="Gray"/>
    </Page.Resources>

    <DockPanel>
        <DockPanel.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF5F7" Offset="0"/>
                <GradientStop Color="#FFE3E8" Offset="1"/>
            </LinearGradientBrush>
        </DockPanel.Background>

        <Border DockPanel.Dock="Top" Background="White" Padding="15" BorderBrush="#FFD1DC" BorderThickness="0,0,0,2">
            <Grid>
                <Button Content="← Back" 
                        Click="BackButton_Click" 
                        HorizontalAlignment="Left" 
                        Background="#FF6B81" 
                        Foreground="White" 
                        FontSize="12" 
                        Padding="15,5" 
                        BorderThickness="0"/>

                <TextBlock Text="Matches" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Foreground="#333333"/>
            </Grid>
        </Border>

        <ListBox x:Name="MatchesListBox" 
                 SelectionChanged="MatchesListBox_SelectionChanged" 
                 Background="Transparent" 
                 BorderThickness="0" 
                 Margin="20">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,8"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="15" Padding="15" BorderBrush="#FFD1DC" BorderThickness="1" Effect="{DynamicResource ShadowEffect}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="55" Height="55" Fill="#FFB7C5"/>
                            <TextBlock Text="{Binding DisplayName}" 
                                       FontSize="18" 
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" 
                                       Margin="20,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Page>