<Page x:Class="Meetandgreet.Pages.Chatwindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:converters="clr-namespace:Meetandgreet.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Chatwindow">

    <Page.Resources>
        <converters:ChatBubbleConverter x:Key="ChatConverter"/>
    </Page.Resources>

    <DockPanel LastChildFill="True">
        <DockPanel.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF5F7" Offset="0"/>
                <GradientStop Color="#FFE3E8" Offset="1"/>
            </LinearGradientBrush>
        </DockPanel.Background>

        <Border DockPanel.Dock="Top" Background="White" Padding="15" BorderThickness="0,0,0,1" BorderBrush="#FFD1DC">
            <Grid>
                <Button Content="Back" Click="BackButton_Click" HorizontalAlignment="Left" Width="60"/>
                <TextBlock x:Name="ChatHeader" Text="Chatting with..." HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Height="60" Background="White">
            <TextBox x:Name="MessageInput" Width="600" Margin="10" VerticalContentAlignment="Center"/>
            <Button Content="Send" Click="OnSendMessage_Click" Width="80" Margin="5"/>
        </StackPanel>

        <ListBox x:Name="ChatListBox" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5" HorizontalAlignment="{Binding Sender.Id, Converter={StaticResource ChatConverter}, ConverterParameter=Align}">
                        <Border Padding="10" 
                                Background="{Binding Sender.Id, Converter={StaticResource ChatConverter}, ConverterParameter=Color}" 
                                CornerRadius="10">
                            <TextBlock Text="{Binding MessageText}" Foreground="White" TextWrapping="Wrap" MaxWidth="300"/>
                        </Border>
                        <TextBlock Text="{Binding SentAt, StringFormat='HH:mm'}" FontSize="10" Foreground="Gray" HorizontalAlignment="Right"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Page>