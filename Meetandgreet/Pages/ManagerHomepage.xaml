<Page x:Class="Meetandgreet.Pages.ManagerHomepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Manager Dashboard">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/cupids.jpg" Stretch="UniformToFill" Opacity="0.3"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111111" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">
                <Button Height="50" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="☰" Foreground="#FF4D4D" FontSize="24"/>
                </Button>
                <Separator Background="#22FFFFFF" Margin="10,15,10,15"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock Text="System User Management" Foreground="White" FontSize="28" 
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <ListBox x:Name="UserListBox" 
                         Background="#222222" 
                         BorderBrush="#33FFFFFF" 
                         Width="500" Height="400" 
                         Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="10" Width="480">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Username}" Width="250" VerticalAlignment="Center" FontSize="16"/>

                                    <Button Content="Edit" Click="Edit_Click" Margin="10,0" 
                                            Background="#444444" Foreground="White" Padding="10,2"/>
                                    <Button Content="Delete" Click="Delete_Click" 
                                            Background="#FF4D4D" Foreground="White" Padding="10,2"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>
        </Grid>
    </Grid>
</Page>