<Page x:Class="Meetandgreet.Pages.Settingup2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Meetandgreet.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Settingup2">

    <Grid>
        <Image Source="/Images/apples.png" Stretch="UniformToFill" />
        <Border Background="#80FFB300" Opacity="0.3" />

        <Viewbox Stretch="Uniform" MaxHeight="850">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" 
                Width="450" Padding="35" CornerRadius="30"
                Background="#CC1A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Step 2" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="meet and greet wants to get to know you..." Foreground="#F7E7CE" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                    <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Width="110" Height="110" Stroke="#F7E7CE" StrokeThickness="2" StrokeDashArray="4 2">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultprofile.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Button Content="+" Width="30" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Background="#FF4D4D" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <TextBlock Text="About Me" Foreground="White" FontSize="12" Margin="5,0,0,5"/>
                    <TextBox Height="100" Margin="0,0,0,20" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="#33FFFFFF" Foreground="White" BorderBrush="#66F7E7CE" Padding="10">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="Interested in..." Foreground="White" FontSize="12" Margin="5,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                        <RadioButton Content="Males" Foreground="White" Margin="0,0,15,0"/>
                        <RadioButton Content="Females" Foreground="White" Margin="0,0,15,0"/>
                        <RadioButton Content="Both" Foreground="White" IsChecked="True"/>
                    </StackPanel>

                    <Button Content="FINISH SETUP" Height="55" Background="#FF4D4D" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="Finish_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="27"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</Page>
