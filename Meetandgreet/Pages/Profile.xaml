<Page x:Class="Meetandgreet.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Profile">

    <Page.Background>
        <ImageBrush ImageSource="/Images/glassbg.jpg" 
                    Stretch="UniformToFill" 
                    Opacity="0.8"/>
    </Page.Background>

    <StackPanel Margin="40" MaxWidth="500">
        <Button Content="← Back" Click="BackBtn_Click" HorizontalAlignment="Left" 
                Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,0,20"/>

        <Border Width="200" Height="200" CornerRadius="100" Background="#333333" HorizontalAlignment="Center">
            <Image x:Name="ProfilePhoto" Stretch="UniformToFill"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock x:Name="UsernameTxt" FontSize="32" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="AgeTxt" FontSize="32" Margin="15,0,0,0" Foreground="#FF4D4D"/>
        </StackPanel>

        <TextBlock x:Name="BioTxt" TextAlignment="Center" Foreground="#DDFFFFFF" 
                   Margin="0,20,0,0" TextWrapping="Wrap" FontSize="16"/>

        <Button x:Name="EditProfileBtn" Content="Edit Profile" Margin="0,30,0,0" 
        Background="#FF4D4D" Foreground="White" Padding="10" 
        Click="EditProfileBtn_Click" />
        <StackPanel Margin="40" MaxWidth="500">
            <TextBlock Text="Choose Background Color:" Foreground="White" Margin="0,20,0,5"/>
            <ComboBox x:Name="ColorPicker" SelectionChanged="ColorPicker_SelectionChanged" Width="200" HorizontalAlignment="Left">
                <ComboBoxItem Content="Black" Tag="#111111"/>
                <ComboBoxItem Content="Dark Blue" Tag="#1a1a2e"/>
                <ComboBoxItem Content="Dark Red" Tag="#2e1111"/>
                <ComboBoxItem Content="Dark Green" Tag="#112e11"/>
                <ComboBoxItem Content="Purple" Tag="#2a112e"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Vertical" Margin="0,50,0,0">
            <Button x:Name="LogoutBtn" 
            Content="Log Out" 
            Click="LogoutBtn_Click" 
            Background="#444444" 
            Foreground="White" 
            Padding="10" 
            Margin="0,0,0,10"
            Cursor="Hand"/>

            <Button x:Name="DeleteAccBtn" 
            Content="Delete Account" 
            Click="DeleteAccBtn_Click" 
            Background="#8B0000" 
            Foreground="White" 
            Padding="10" 
            Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Page>