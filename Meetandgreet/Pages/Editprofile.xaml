<Page x:Class="Meetandgreet.Pages.Editprofile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Editprofile">
    <Grid>
        <Button Content="← Back" 
        Click="BackBtn_Click" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Top" 
        Margin="20" 
        Background="Transparent" 
        Foreground="White" 
        BorderThickness="0" 
        FontSize="16" 
        Cursor="Hand" 
        Panel.ZIndex="10"/>
        <StackPanel Margin="40" MaxWidth="500" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse Width="120" Height="120" Stroke="#F7E7CE" StrokeThickness="2">
                <Ellipse.Fill>
                    <ImageBrush x:Name="ProfileImageBrush" Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>

            <Button Content="Change Picture" Click="UploadPic_Click" Margin="0,10,0,20"/>

            <TextBlock Text="Edit Bio:" Foreground="White"/>
            <TextBox x:Name="BioInput" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>

            <Button Content="Save Changes" Click="SaveBtn_Click" Background="#FF4D4D" Foreground="White" Margin="0,20,0,0"/>
            <Button Content="Back" Click="BackBtn_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>