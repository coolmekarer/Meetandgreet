<Page x:Class="Meetandgreet.Pages.Homepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Meetandgreet.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Homepage">

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FFFBE9E7" Offset="0" />
                    <GradientStop Color="#FFFFCCBC" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel VerticalAlignment="Top" Margin="20">
            <TextBlock Text="Discover" FontSize="32" FontWeight="Bold" Foreground="#E65100" />

            <Border Margin="0,30,0,0" Height="400" Width="300" 
                    CornerRadius="20" Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="5"/>
                </Border.Effect>

                <Grid>
                    <Image Source="/Images/placeholder_match.jpg" Stretch="UniformToFill" />

                    <StackPanel VerticalAlignment="Bottom" Background="#80000000" Height="80">
                        <TextBlock Text="Eve, 24" Foreground="White" FontSize="20" Margin="15,10,0,0" FontWeight="Bold"/>
                        <TextBlock Text="Loves apples and long walks in gardens." Foreground="White" Margin="15,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="✘" Width="70" Height="70" FontSize="30" Margin="0,0,20,0" Background="White" Foreground="Red">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="35"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="❤" Width="70" Height="70" FontSize="30" Background="#FF4D4D" Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="35"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
