<Page x:Class="Meetandgreet.Pages.Homepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Meetandgreet.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="850"
      Title="Homepage">

    <Grid>
        <!-- Page Background Layer -->
        <Grid.Background>
            <ImageBrush ImageSource="/Images/cupids.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Split: Left Sidebar vs Main Feed Work Area -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar Panel -->
        <Border Grid.Column="0" Background="#111111" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0" Panel.ZIndex="5">
            <Grid>
                <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">

                    <!-- Menu Hamburger Expand Toggle -->
                    <Button x:Name="ToggleMenuBtn" Height="50" Background="Transparent" BorderThickness="0" Click="ToggleMenu_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0">
                            <TextBlock Text="☰" Foreground="#FF4D4D" FontSize="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MenuTitleText" Text=" Menu" Foreground="White" FontSize="16" FontWeight="Bold" Margin="15,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>

                    <Separator Background="#22FFFFFF" Margin="10,15,10,15"/>

                    <!-- Profile Screen Link -->
                    <Button x:Name="ProfileNavBtn" Height="50" Background="Transparent" BorderThickness="0" Click="ProfileNav_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0">
                            <TextBlock Text="👤" Foreground="White" FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProfileText" Text="My Profile" Foreground="White" FontSize="14" Margin="18,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>

                    <!-- Active Chats Link -->
                    <Button x:Name="ChatsNavBtn" Height="50" Background="Transparent" BorderThickness="0" Click="ChatsNav_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0">
                            <TextBlock Text="💬" Foreground="White" FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ChatsText" Text="Matches &amp; Chats" Foreground="White" FontSize="14" Margin="18,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Main Feed: Side-by-Side Layout Row -->
        <Grid Grid.Column="1" x:Name="MainContentArea" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Left Slot: Pass Button -->
                <ColumnDefinition Width="Auto" />
                <!-- Center Slot: Card Frame -->
                <ColumnDefinition Width="*" />
                <!-- Right Slot: Like Button -->
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDE: PASS BUTTON (✕) ================= -->
            <Button Grid.Column="0" Content="✕" Width="60" Height="60" HorizontalAlignment="Right" Margin="0,0,40,0"
                    Background="#333333" Foreground="#FF4D4D" FontSize="24" FontWeight="Bold" Cursor="Hand" Click="PassUser_Click">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="30" BorderBrush="#FF4D4D" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- FIXED: Explicitly added missing closing tag -->
                </Button.Resources>
            </Button>

            <!-- ================= CENTER SIDE: USER PROFILE CARD ================= -->
            <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="400" Height="500" CornerRadius="25" Background="#222222" 
                        BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True" Panel.ZIndex="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Profile Photo Background -->
                        <Image x:Name="CurrentDisplayedImage" Grid.Row="0" Grid.RowSpan="2" Stretch="UniformToFill"/>

                        <!-- Left/Right Transparent Picture Navigation Hit-zones -->
                        <Grid Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PrevPicBtn" Background="Transparent" BorderThickness="0" Click="PrevPic_Click" Cursor="Hand"/>
                            <Button x:Name="NextPicBtn" Grid.Column="1" Background="Transparent" BorderThickness="0" Click="NextPic_Click" Cursor="Hand"/>
                        </Grid>

                        <!-- Bottom Text Overlay Container Sheet -->
                        <Border Grid.Row="1" Panel.ZIndex="2" Background="#E6111111" Padding="20,15,20,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock x:Name="FeedUsernameTxt" Text="Loading Name..." FontSize="26" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="FeedAgeTxt" Text="--" FontSize="26" Margin="12,0,0,0" Foreground="#F7E7CE"/>
                                </StackPanel>

                                <TextBlock x:Name="FeedBioTxt" Text="Profile description will load up contextually inside this field layout string location." 
                                           FontSize="14" Foreground="#DDFFFFFF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" 
                                           MaxHeight="40" MouseDown="ToggleBioExpand_MouseDown" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= RIGHT SIDE: LIKE BUTTON (♥) ================= -->
            <Button Grid.Column="2" Content="♥" Width="60" Height="60" HorizontalAlignment="Left" Margin="40,0,0,0"
                    Background="#FF4D4D" Foreground="White" FontSize="28" Cursor="Hand" Click="LikeUser_Click">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="30">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- FIXED: Explicitly added missing closing tag -->
                </Button.Resources>
            </Button>

        </Grid>
    </Grid>
</Page>